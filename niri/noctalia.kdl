layout {

    focus-ring {
        active-color   "#a7d474"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7d474"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a7d474"
        inactive-color "#2d5000"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7d47480"
    }
}

recent-windows {
    highlight {
        active-color "#a7d474"
        urgent-color "#ffb4ab"
    }
}
